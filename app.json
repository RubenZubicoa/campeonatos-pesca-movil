{
  "expo": {
    "name": "The Lake",
    "slug": "campeonatos-pesca-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campeonatospescamovil",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0a08",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-the-lake.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0a08"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita tus fotos para adjuntar la captura.",
          "cameraPermission": "La app necesita la cámara para fotografiar la captura."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
